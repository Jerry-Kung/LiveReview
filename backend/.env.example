# 后端环境变量样例（复制为 .env 使用；不含真实凭据）
APP_ENV=development
DATABASE_URL=sqlite:///./data/liverreview.db
LOG_LEVEL=INFO
# 服务监听地址与端口（本地开发默认开启 reload）
APP_HOST=127.0.0.1
APP_PORT=12439
APP_RELOAD=true
# 对象存储：auto（有凭据用 TOS，无凭据回落 Mock）/ tos（强制真实）/ mock（本地内存）
STORAGE_BACKEND=auto
# TOS 对象存储（V0.1.2 起使用；AK/SK 仅从环境变量读取，禁止提交到仓库）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_OBJECT_PREFIX=liverreview/
TOS_PRESIGNED_TTL_SECONDS=3600
# 本地产物根目录：上传分片、合并临时文件与待探测的原始视频副本（容器内为 /app/media）
MEDIA_ROOT=./media
# 上传分片大小（字节）：由后端下发给前端，前端不硬编码；默认 8MB
UPLOAD_CHUNK_SIZE=8388608
# 媒体工具路径（V0.1.4 起用 ffprobe 探测，V0.1.5 起用 ffmpeg 转封装与切分；本地不部署，测试环境镜像已安装）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 单次探测超时（秒）与 ffprobe 输出长度上限（字节）
PROBE_TIMEOUT_SECONDS=300
PROBE_MAX_OUTPUT_BYTES=8388608
# 切分约束（V0.1.5）：单片最长时长（秒）与最大体积（字节），默认即「≤60 分钟、≤1GB」
SPLIT_MAX_DURATION_SECONDS=3600
SPLIT_MAX_CLIP_BYTES=1073741824
# 体积超限时递归对半的下限（秒）：到达下限仍超限则判定失败
SPLIT_MIN_CLIP_SECONDS=1.0
# 单次转封装/切片调用的超时（秒）
SPLIT_TIMEOUT_SECONDS=600
# ffmpeg stderr 收集上限（字节）
FFMPEG_MAX_OUTPUT_BYTES=8388608
# 模型接入（V0.2）：音画理解模型，OpenAI 兼容的 responses 接口；三项均为必填，只从环境变量读取
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL_NAME=doubao-seed-2-1-pro-260628
# 单次视频理解请求的超时（秒）：分钟级任务，默认 900s，素材更长时上调
LLM_TIMEOUT_SECONDS=900
# 送模型的采样帧率（1fps 为示例代码取值）
LLM_FPS=1
# 单片识别的最大尝试次数（含首次）：瞬时故障退避重试，超出即判该片失败
LLM_MAX_ATTEMPTS=3
# 片段识别并发数：模型侧限流未知，默认串行；确认配额后再上调
LLM_CONCURRENCY=1
# 预签名视频 URL 的有效期（秒）：须覆盖排队与单次识别耗时
LLM_CLIP_URL_TTL_SECONDS=7200
# 识别任务的提示词：留空使用默认题面（识别片段中的所有人声语音）
LLM_UNDERSTANDING_PROMPT=
