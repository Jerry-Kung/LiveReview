# 后端环境变量样例（复制为 .env 使用；不含真实凭据）
APP_ENV=development
DATABASE_URL=sqlite:///./data/liverreview.db
LOG_LEVEL=INFO
# 服务监听地址与端口（本地开发默认开启 reload）
APP_HOST=127.0.0.1
APP_PORT=12439
APP_RELOAD=true
# TOS 对象存储（V0.1.2 起使用，V0.1.1 仅预留占位）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
# 媒体工具路径（V0.1.4 起使用，V0.1.1 仅预留占位）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
