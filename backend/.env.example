# 后端环境变量样例（复制为 .env 使用；不含真实凭据）
APP_ENV=development
DATABASE_URL=sqlite:///./data/liverreview.db
LOG_LEVEL=INFO
# 服务监听地址与端口（本地开发默认开启 reload）
APP_HOST=127.0.0.1
APP_PORT=12439
APP_RELOAD=true
# 对象存储：auto（有凭据用 TOS，无凭据回落 Mock）/ tos（强制真实）/ mock（本地内存）
STORAGE_BACKEND=auto
# TOS 对象存储（V0.1.2 起使用；AK/SK 仅从环境变量读取，禁止提交到仓库）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_OBJECT_PREFIX=liverreview/
TOS_PRESIGNED_TTL_SECONDS=3600
# 媒体工具路径（V0.1.4 起使用，V0.1.1 仅预留占位）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
