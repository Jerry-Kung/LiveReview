# 后端环境变量样例（复制为 .env 使用；不含真实凭据）
APP_ENV=development
DATABASE_URL=sqlite:///./data/liverreview.db
LOG_LEVEL=INFO
# 服务监听地址与端口（本地开发默认开启 reload）
APP_HOST=127.0.0.1
APP_PORT=12439
APP_RELOAD=true
# 对象存储：auto（有凭据用 TOS，无凭据回落 Mock）/ tos（强制真实）/ mock（本地内存）
STORAGE_BACKEND=auto
# TOS 对象存储（V0.1.2 起使用；AK/SK 仅从环境变量读取，禁止提交到仓库）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_OBJECT_PREFIX=liverreview/
TOS_PRESIGNED_TTL_SECONDS=3600
# 本地产物根目录：上传分片、合并临时文件与待探测的原始视频副本（容器内为 /app/media）
MEDIA_ROOT=./media
# 上传分片大小（字节）：由后端下发给前端，前端不硬编码；默认 8MB
UPLOAD_CHUNK_SIZE=8388608
# 媒体工具路径（V0.1.4 起用 ffprobe 探测，V0.1.5 起用 ffmpeg 转码；本地不部署，测试环境镜像已安装）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 单次探测超时（秒）与 ffprobe 输出长度上限（字节）
PROBE_TIMEOUT_SECONDS=300
PROBE_MAX_OUTPUT_BYTES=8388608
